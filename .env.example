# ─── Resend (изпращане на имейли) ───────────────────────────
# API ключ от https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Подател. Домейнът трябва да е верифициран в Resend.
FROM_EMAIL="Just Pablo <zapitvane@just-pablo.com>"

# Кой получава известията за нови запитвания (едно писмо до двамата).
TO_EMAIL_PRIMARY=adsjustpablo@gmail.com
TO_EMAIL_SECONDARY=

# Reply-To на потвърждението към клиента. ВАЖНО: трябва да е кутия, която
# реално приема поща — just-pablo.com няма MX записи, така че отговорите на
# zapitvane@just-pablo.com се губят.
CLIENT_REPLY_TO=adsjustpablo@gmail.com

# ─── Cloudflare Turnstile ───────────────────────────────────
# ЗАДЪЛЖИТЕЛЕН за защита от ботове. Без него формата приема всичко
# и в логовете на Vercel се появява предупреждение при всяко запитване.
# Взима се от Cloudflare → Turnstile → widget-а „just-pablo.com forma
# za zapitvaniya" → Secret key. Site key-ът е публичен и е в кода
# (src/lib/turnstile.ts).
TURNSTILE_SECRET_KEY=

# true = липсващ токен също блокира. По подразбиране false, защото токенът
# липсва и при реални клиенти с блокер на реклами. Включи го само ако
# спамът продължава и си готов да загубиш част от тези хора.
TURNSTILE_REQUIRE_TOKEN=false

# ─── Блокирани податели (по избор) ──────────────────────────
# Допълват вградения списък в api/send-email.js. Разделени със запетая.
BLOCKED_EMAILS=
BLOCKED_DOMAINS=
